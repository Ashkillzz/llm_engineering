# OpenAI API Key (Required for Scanner Agent & Frontier Agent)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face Token (Required for gated LLaMA models & Hub access)
HF_TOKEN=your_huggingface_token_here

# DeepSeek API Key (Optional: Alternative provider for Frontier Agent)
DEEPSEEK_API_KEY=

# Modal Credentials (Required for remote GPU inference)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Database Connection (Defaults to SQLite deals.db if omitted)
# For production PostgreSQL: postgresql://user:password@localhost:5432/deal_scout
DATABASE_URL=sqlite:///deals.db

# Pushover Notifications (Optional: For push alerts on high-margin deals)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Twilio SMS (Optional: For SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MY_PHONE_NUMBER=
