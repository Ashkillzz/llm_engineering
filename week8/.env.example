# Database Configuration
# For local development with PostgreSQL
DATABASE_URL=postgresql://llm_user:secure_password@localhost:5432/price_is_right

# For alternative PostgreSQL hosts
# DATABASE_URL=postgresql://user:password@hostname:port/database_name

# API Keys
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# Twilio Configuration (optional, for SMS alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Modal Configuration
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# Other Configuration
LOG_LEVEL=INFO
